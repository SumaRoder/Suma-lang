pub list_sum(items: List): Int {
    total = 0
    for v in items {
        @total += v
    }
    return total
}

pub list_product(items: List): Int {
    result = 1
    for v in items {
        @result *= v
    }
    return result
}

pub list_max(items: List): Int {
    if items.size == 0 {
        return 0
    }
    best = items[0]
    for v in items {
        if v > best {
            @best = v
        }
    }
    return best
}

pub list_min(items: List): Int {
    if items.size == 0 {
        return 0
    }
    best = items[0]
    for v in items {
        if v < best {
            @best = v
        }
    }
    return best
}

pub list_push_range(items: List, start: Int, end: Int): Int {
    for i in start..=end {
        items.add(i)
    }
    return items.size
}
