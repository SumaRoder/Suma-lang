pub Person {
    pri const name: Str
        .getter
    pri age: Int = 0
        .getter
    pri const default_msg: Str = "这个入很懒，什么也没有留下～"
    pri msg: Str
        .getter
        .setter

    pub init(name: Str, age: Int, msg?: Str = null) {
        this.name = name
        this.age = age
        if (msg) this.msg = msg
    }

    pub grow(years?: Int = 1): Int {
        this.age += years
        return this.age
    }

    pub to_str(): Str {
        base: Str = this.name + " aged " + this.age
        if (this.msg != null && this.msg != this.default_msg) {
            return base + " says " + this.msg
        }
        return base
    }
}

pub divide(a: Int, b: Int): R<Int, Str> {
    if (b == 0) {
        return Err("Cannot devide by zero")
    }
    return Ok(a / b)
}

pub main(): Int {
    p1: Person = Person("Elizabeth Kashamilar Roiat", 18)
    p2: Person = Person("St. John Roiat", 17, "Hi")
    
    print("Person 1: " + p1.to_str())
    print("Person 2: " + p2.to_str())
    
    print("")
    
    new_age: Int = p1.grow(5)
    print("After growing 5 years: " + p1.to_str())
    print("Returned age: " + new_age)
    
    p1.grow()
    print("After default grow (1 year): " + p1.to_str())
    
    print("")
    
    ok_result: R<Int, Str> = divide(100, 5)
    ok_result -> {
        Ok {
            print("100 / 5 = " + it)
        }
        Err = print("错误: " + it)
    }
    
    ok_value: Int = divide(20, 4).must_ok()
    print("20 / 4 = " + ok_value)
    
    print("")
    
    err_result: R<Int, Str> = divide(10, 0)
    err_result -> {
        Ok {
            print("结果: " + it)
        }
        Err = print("捕获错误: " + it)
    }
    
    print("")
    
    x: Int = 10
    x += 5
    print("x += 5: " + x)
    
    y: Int = 20
    y -= 3
    print("y -= 3: " + y)
    
    z: Int = x + y * 2
    print("z = x + y * 2: " + z)
    
    print("")
    
    max_val: Int = (x > y) ? x : y
    print("max(x, y): " + max_val)
    
    msg: Str = (x == 15) ? "x is 15" : "x is not 15"
    print(msg)
    
    print("")
    
    a: Int = 5    // 101
    b: Int = 3    // 011
    print("5 & 3 = " + (a & b))   // 001 = 1
    print("5 | 3 = " + (a | b))   // 111 = 7
    print("5 ^ 3 = " + (a ^ b))   // 110 = 6
    print("~5 = " + (~a))         // ~101 = ...11111010
    
    return 0
}
