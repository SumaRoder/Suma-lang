import "core.nk"

pub Random {
    pri seed: Int
    pri state: Int

    pub setup(initialSeed?: Int = 0) {
        if (initialSeed == 0) {
            this.seed = current_time_millis()
        } else {
            this.seed = initialSeed
        }
        this.state = this.seed
    }

    pub next(): Int {
        this.state = (this.state * 1103515245 + 12345) & 2147483647
        return this.state
    }

    pub next_int(max: Int): Int {
        if (max <= 0) return 0
        return this.next() % max
    }

    pub next_range(min: Int, max: Int): Int {
        if (min > max) {
            temp: Int = min
            min = max
            max = temp
        }
        range: Int = max - min + 1
        return min + (this.next() % range)
    }

    pub next_bool(): Bool {
        return (this.next() % 2) == 0
    }

    pub choice(list: List): Any {
        if (list.size == 0) {
            return Err("Cannot choose from empty list")
        }
        idx: Int = this.next_int(list.size)
        return Ok(list[idx])
    }

    pub choices(list: List, n: Int): List {
        if (list.size == 0 || n <= 0) return List()
        result: List = List()
        i: Int = 0
        loop {
            if (i >= n) break
            idx: Int = this.next_int(list.size)
            result.add(list[idx])
            i += 1
        }
        return result
    }

    pub sample(list: List, n: Int): Any {
        if (n > list.size) {
            return Err("Sample size larger than list")
        }
        if (n <= 0) return Ok(List())

        result: List = List()
        i: Int = 0
        loop {
            if (i >= list.size) break
            result.add(list[i])
            i += 1
        }

        i = result.size - 1
        limit: Int = result.size - n
        loop {
            if (i < limit) break
            j: Int = this.next_int(i + 1)
            temp: Any = result[i]
            result[i] = result[j]
            result[j] = temp
            i -= 1
        }

        sampled: List = List()
        i = 0
        loop {
            if (i >= n) break
            sampled.add(result[i])
            i += 1
        }
        return Ok(sampled)
    }

    pub shuffle(list: List): List {
        result: List = List()
        i: Int = 0
        loop {
            if (i >= list.size) break
            result.add(list[i])
            i += 1
        }

        i = result.size - 1
        loop {
            if (i <= 0) break
            j: Int = this.next_int(i + 1)
            temp: Any = result[i]
            result[i] = result[j]
            result[j] = temp
            i -= 1
        }
        return result
    }

    pub reset() {
        this.state = this.seed
    }

    pub reseed(newSeed: Int) {
        this.seed = newSeed
        this.state = newSeed
    }
}

pub Timer {
    pri startTime: Int = 0
    pri elapsed: Int = 0
    pri running: Bool = false

    pub setup() {}

    pub start() {
        this.startTime = currentTimeMillis()
        this.running = true
    }

    pub stop(): Int {
        if (!this.running) return this.elapsed
        now: Int = currentTimeMillis()
        this.elapsed = this.elapsed + (now - this.startTime)
        this.running = false
        return this.elapsed
    }

    pub reset() {
        this.elapsed = 0
        this.running = false
    }

    pub restart() {
        this.reset()
        this.start()
    }

    pub elapsed(): Int {
        if (this.running) {
            now: Int = currentTimeMillis()
            return this.elapsed + (now - this.startTime)
        }
        return this.elapsed
    }

    pub is_running(): Bool {
        return this.running
    }

    pub lap(): Int {
        if (!this.running) return 0
        now: Int = currentTimeMillis()
        lapTime: Int = now - this.startTime
        this.elapsed = this.elapsed + lapTime
        this.startTime = now
        return lapTime
    }
}

pub ms_per_second(): Int { return 1000 }
pub ms_per_minute(): Int { return 60000 }
pub ms_per_hour(): Int { return 3600000 }
pub ms_per_day(): Int { return 86400000 }

pub ms_to_seconds(ms: Int): Int {
    return ms / 1000
}

pub ms_to_minutes(ms: Int): Int {
    return ms / 60000
}

pub ms_to_hours(ms: Int): Int {
    return ms / 3600000
}

pub seconds_to_ms(seconds: Int): Int {
    return seconds * 1000
}

pub minutes_to_ms(minutes: Int): Int {
    return minutes * 60000
}

pub hours_to_ms(hours: Int): Int {
    return hours * 3600000
}

pub format_duration(ms: Int): Str {
    if (ms < 0) ms = -ms

    hours: Int = ms / ms_per_hour
    ms = ms % ms_per_hour

    minutes: Int = ms / ms_per_minute
    ms = ms % ms_per_minute

    seconds: Int = ms / ms_per_second
    ms = ms % ms_per_second

    if (hours > 0) {
        return pad_int(hours) + ":" + pad_int(minutes) + ":" + pad_int(seconds)
    } else if (minutes > 0) {
        return pad_int(minutes) + ":" + pad_int(seconds)
    } else {
        return Str(seconds) + "." + pad_int_3(ms) + "s"
    }
}

pub format_duration_brief(ms: Int): Str {
    if (ms < 0) ms = -ms

    if (ms < 1000) {
        return Str(ms) + "ms"
    } else if (ms < 60000) {
        seconds: Int = ms / 1000
        remMs: Int = ms % 1000
        return Str(seconds) + "." + Str(remMs / 100) + "s"
    } else if (ms < 3600000) {
        minutes: Int = ms / 60000
        seconds: Int = (ms % 60000) / 1000
        return Str(minutes) + "m" + Str(seconds) + "s"
    } else {
        hours: Int = ms / 3600000
        minutes: Int = (ms % 3600000) / 60000
        return Str(hours) + "h" + Str(minutes) + "m"
    }
}

pub benchmark(fn: Function, iterations?: Int = 1): Int {
    timer: Timer = Timer()
    timer.setup()
    timer.start()

    i: Int = 0
    loop {
        if (i >= iterations) break
        fn()
        i += 1
    }

    return timer.stop()
}

pub measure(fn: Function): Any {
    timer: Timer = Timer()
    timer.setup()
    timer.start()

    result = fn()

    elapsed: Int = timer.stop()
    return Pair(result, elapsed)
}

pri pad_int(n: Int): Str {
    if (n < 10) return "0" + Str(n)
    return Str(n)
}

pri pad_int_3(n: Int): Str {
    if (n < 10) return "00" + Str(n)
    if (n < 100) return "0" + Str(n)
    return Str(n)
}

pub measure(fn: Function): Any {
    timer: Timer = Timer()
    timer.setup()
    timer.start()

    result = fn()

    elapsed: Int = timer.stop()
    return Pair(result, elapsed)
}

pri pad_int(n: Int): Str {
    if (n < 10) return "0" + Str(n)
    return Str(n)
}

pri pad_int3(n: Int): Str {
    if (n < 10) return "00" + Str(n)
    if (n < 100) return "0" + Str(n)
    return Str(n)
}
