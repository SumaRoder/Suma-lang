pub assert_true(value: Bool, msg: Str) {
    if (!value) {
        panic("Assertion failed: " + msg)
    }
}

pub assert_false(value: Bool, msg: Str) {
    if (value) {
        panic("Assertion failed: " + msg)
    }
}

pub assert_null(value: Any, msg: Str) {
    if (value != null) {
        panic("Assertion failed: " + msg + " - Got: " + Str(value))
    }
}

pub assert_not_null(value: Any, msg: Str) {
    if (value == null) {
        panic("Assertion failed: " + msg + " - Value is null")
    }
}

pub assert_eq(actual: Any, expected: Any, msg: Str) {
    if (actual != expected) {
        panic("Assertion failed: " + msg + " - Expected " + expected + ", got " + actual)
    }
}

pub assert_ne(actual: Any, expected: Any, msg: Str) {
    if (actual == expected) {
        panic("Assertion failed: " + msg + " - Values are equal: " + Str(actual))
    }
}

pub assert_gt(a: Int, b: Int, msg: Str) {
    if (!(a > b)) {
        panic("Assertion failed: " + msg + " - " + Str(a) + " is not > " + Str(b))
    }
}

pub assert_lt(a: Int, b: Int, msg: Str) {
    if (!(a < b)) {
        panic("Assertion failed: " + msg + " - " + Str(a) + " is not < " + Str(b))
    }
}

pub assert_ge(a: Int, b: Int, msg: Str) {
    if (!(a >= b)) {
        panic("Assertion failed: " + msg + " - " + Str(a) + " is not >= " + Str(b))
    }
}

pub assert_le(a: Int, b: Int, msg: Str) {
    if (!(a <= b)) {
        panic("Assertion failed: " + msg + " - " + Str(a) + " is not <= " + Str(b))
    }
}

pub assert_ok(result: Any, msg: Str) {
    result -> {
        Ok {}
        Err = panic("Assertion failed: " + msg + " - Got Err: " + Str(it))
    }
}

pub assert_err(result: Any, msg: Str) {
    result -> {
        Ok = panic("Assertion failed: " + msg + " - Got Ok: " + Str(it))
        Err {}
    }
}

pub assert_contains(list: List, item: Any, msg: Str) {
    i: Int = 0
    found: Bool = false
    loop {
        if (i >= list.size) break
        if (list[i] == item) {
            found = true
            break
        }
        i += 1
    }
    if (!found) {
        panic("Assertion failed: " + msg + " - List does not contain " + Str(item))
    }
}

pub assert_not_contains(list: List, item: Any, msg: Str) {
    i: Int = 0
    found: Bool = false
    loop {
        if (i >= list.size) break
        if (list[i] == item) {
            found = true
            break
        }
        i += 1
    }
    if (found) {
        panic("Assertion failed: " + msg + " - List contains " + Str(item))
    }
}

pub assert_empty(list: List, msg: Str) {
    if (list.size != 0) {
        panic("Assertion failed: " + msg + " - List is not empty, size=" + Str(list.size))
    }
}

pub assert_not_empty(list: List, msg: Str) {
    if (list.size == 0) {
        panic("Assertion failed: " + msg + " - List is empty")
    }
}

pub fail(msg: Str) {
    panic("Test failed: " + msg)
}

pub panic(msg: Str) {
    throw(msg)
}
