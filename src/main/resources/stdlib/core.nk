pub is_ok(result): Bool {
    return result -> {
        Ok = true
        Err = false
    }
}

pub is_err(result): Bool {
    return result -> {
        Ok = false
        Err = true
    }
}

pub unwrap_or(result, default): Any {
    return result -> {
        Ok = it
        Err = default
    }
}

pub unwrap_or_else(result, fn: Function): Any {
    return result -> {
        Ok = it
        Err = fn(it)
    }
}

pub map(result, fn: Function): Any {
    return result -> {
        Ok = Ok(fn(it))
        Err = result
    }
}

pub map_err(result, fn: Function): Any {
    return result -> {
        Ok = result
        Err = Err(fn(it))
    }
}

pub and_then(result, fn: Function): Any {
    return result -> {
        Ok = fn(it)
        Err = result
    }
}

pub or_else(result, fn: Function): Any {
    return result -> {
        Ok = result
        Err = fn(it)
    }
}

pub expect(result, msg: Str): Any {
    return result -> {
        Ok = it
        Err = panic(msg + ": " + Str(it))
    }
}

pub unwrap(result): Any {
    return expect(result, "Called unwrap on Err")
}

pub flatten(result): Any {
    return result -> {
        Ok = it
        Err = result
    }
}

pub panic(msg: Str): Any {
    throw(msg)
}

pub assert(cond: Bool, msg?: Str = "Assertion failed") {
    if (!cond) {
        panic(msg)
    }
}

pub Pair {
    pri first_val: Any
    pri second_val: Any

    pub setup(first: Any, second: Any) {
        this.first_val = first
        this.second_val = second
    }

    pub first(): Any {
        return this.first_val
    }

    pub second(): Any {
        return this.second_val
    }

    pub swap(): Pair {
        p: Pair = Pair()
        p.setup(this.second_val, this.first_val)
        return p
    }

    pub to_list(): List {
        return List(this.first_val, this.second_val)
    }

    pub to_str(): Str {
        return "(" + this.first_val + ", " + this.second_val + ")"
    }
}

pub pair(first: Any, second: Any): Pair {
    p: Pair = Pair()
    p.setup(first, second)
    return p
}

pub Range {
    pri start_val: Int
    pri end_val: Int
    pri step_val: Int
    pri cached_size: Int = -1

    pub setup(start: Int, end: Int, step?: Int = 1) {
        assert(step != 0, "Range step cannot be zero")
        this.start_val = start
        this.end_val = end
        this.step_val = step
    }

    pub start(): Int {
        return this.start_val
    }

    pub end(): Int {
        return this.end_val
    }

    pub step(): Int {
        return this.step_val
    }

    pub contains(n: Int): Bool {
        if (this.step_val > 0) {
            return n >= this.start_val && n < this.end_val && (n - this.start_val) % this.step_val == 0
        }
        return n <= this.start_val && n > this.end_val && (this.start_val - n) % (-this.step_val) == 0
    }

    pub to_list(): List {
        result: List = List()
        if (this.step_val > 0) {
            i: Int = this.start_val
            loop {
                if (i >= this.end_val) break
                result.add(i)
                i += this.step_val
            }
        } else {
            i: Int = this.start_val
            loop {
                if (i <= this.end_val) break
                result.add(i)
                i += this.step_val
            }
        }
        return result
    }

    pub size(): Int {
        if (this.cached_size >= 0) {
            return this.cached_size
        }

        if (this.step_val > 0) {
            if (this.start_val >= this.end_val) {
                this.cached_size = 0
            } else {
                this.cached_size = (this.end_val - this.start_val + this.step_val - 1) / this.step_val
            }
        } else {
            if (this.start_val <= this.end_val) {
                this.cached_size = 0
            } else {
                this.cached_size = (this.start_val - this.end_val - this.step_val - 1) / (-this.step_val)
            }
        }
        return this.cached_size
    }

    pub is_empty(): Bool {
        if (this.step_val > 0) {
            return this.start_val >= this.end_val
        }
        return this.start_val <= this.end_val
    }

    pub first(): R<Int, Str> {
        if (this.is_empty()) {
            return Err("Range is empty")
        }
        return Ok(this.start_val)
    }

    pub last(): R<Int, Str> {
        if (this.is_empty()) {
            return Err("Range is empty")
        }
        if (this.step_val > 0) {
            remainder: Int = (this.end_val - this.start_val) % this.step_val
            if (remainder == 0) {
                return Ok(this.end_val - this.step_val)
            }
            return Ok(this.end_val - remainder)
        } else {
            remainder: Int = (this.start_val - this.end_val) % (-this.step_val)
            if (remainder == 0) {
                return Ok(this.end_val - this.step_val)
            }
            return Ok(this.end_val + remainder)
        }
    }

    pub reversed(): Range {
        if (this.is_empty()) {
            return Range(this.start_val, this.end_val, this.step_val)
        }
        last_val: Int = unwrap(this.last())
        return Range(last_val, this.start_val - this.step_val, -this.step_val)
    }
}

pub range(start: Int, end: Int, step?: Int = 1): Range {
    r: Range = Range()
    r.setup(start, end, step)
    return r
}

pub range_to(end: Int): Range {
    r: Range = Range()
    r.setup(0, end, 1)
    return r
}

pub Optional {
    pri value: Any
    pri has_value: Bool

    pub setup(val?: Any = null, has_val?: Bool = false) {
        this.value = val
        this.has_value = has_val
    }

    pub is_some(): Bool {
        return this.has_value
    }

    pub is_none(): Bool {
        return !this.has_value
    }

    pub get(): Any {
        if (!this.has_value) {
            panic("Called get on None")
        }
        return this.value
    }

    pub get_or(default: Any): Any {
        if (this.has_value) {
            return this.value
        }
        return default
    }

    pub get_or_else(fn: Function): Any {
        if (this.has_value) {
            return this.value
        }
        return fn()
    }

    pub map(fn: Function): Optional {
        if (this.has_value) {
            return Optional.some(fn(this.value))
        }
        return Optional.none()
    }

    pub filter(fn: Function): Optional {
        if (this.has_value && fn(this.value)) {
            return this
        }
        return Optional.none()
    }

    pub to_result(err_msg?: Str = "Optional is None"): Any {
        if (this.has_value) {
            return Ok(this.value)
        }
        return Err(err_msg)
    }
}

pub some(val: Any): Optional {
    return Optional.some(val)
}

pub none(): Optional {
    return Optional.none()
}

pub cmp(a, b): Int {
    if (a < b) return -1
    if (a > b) return 1
    return 0
}

pub is_between(n, low, high): Bool {
    return n >= low && n <= high
}

pub in_range(n: Int, r: Range): Bool {
    return r.contains(n)
}
