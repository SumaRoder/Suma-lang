pub take(list: List, n: Int): List {
    if (n <= 0) return List()
    result: List = List()
    count: Int = n
    if (n > list.size) {
        count = list.size
    }
    i: Int = 0
    loop {
        if (i >= count) break
        result.add(list[i])
        i += 1
    }
    return result
}

pub drop(list: List, n: Int): List {
    if (n <= 0) return list
    if (n >= list.size) return List()
    result: List = List()
    i: Int = n
    loop {
        if (i >= list.size) break
        result.add(list[i])
        i += 1
    }
    return result
}

pub take_while(list: List, pred: Function): List {
    result: List = List()
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (!pred(list[i])) break
        result.add(list[i])
        i += 1
    }
    return result
}

pub drop_while(list: List, pred: Function): List {
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (!pred(list[i])) break
        i += 1
    }
    return drop(list, i)
}

pub slice(list: List, start: Int, end?: Int = -1): List {
    s: Int = start
    if (start < 0) { s = 0 }
    e: Int = end
    if (end < 0) { e = list.size }
    if (end > list.size) { e = list.size }
    if (s >= e) return List()
    result: List = List()
    i: Int = s
    loop {
        if (i >= e) break
        result.add(list[i])
        i += 1
    }
    return result
}

pub chunks(list: List, size: Int): List {
    if (size <= 0) return List()
    result: List = List()
    i: Int = 0
    loop {
        if (i >= list.size) break
        chunk: List = slice(list, i, i + size)
        result.add(chunk)
        i += size
    }
    return result
}

pub reverse(list: List): List {
    result: List = List()
    i: Int = list.size - 1
    loop {
        if (i < 0) break
        result.add(list[i])
        i -= 1
    }
    return result
}

pub distinct(list: List): List {
    result: List = List()
    seen: List = List()
    i: Int = 0
    loop {
        if (i >= list.size) break
        item = list[i]
        if (!contains(seen, item)) {
            result.add(item)
            seen.add(item)
        }
        i += 1
    }
    return result
}

pub flatten(list: List): List {
    result: List = List()
    i: Int = 0
    loop {
        if (i >= list.size) break
        item = list[i]
        if (is_list(item)) {
            j: Int = 0
            loop {
                if (j >= item.size) break
                result.add(item[j])
                j += 1
            }
        } else {
            result.add(item)
        }
        i += 1
    }
    return result
}

pub flat_map(list: List, fn: Function): List {
    return flatten(map(list, fn))
}

pub inter_sperse(list: List, sep: Any): List {
    if (list.size == 0) return List()
    result: List = List()
    result.add(list[0])
    i: Int = 1
    loop {
        if (i >= list.size) break
        result.add(sep)
        result.add(list[i])
        i += 1
    }
    return result
}

pub repeat(item: Any, n: Int): List {
    result: List = List()
    i: Int = 0
    loop {
        if (i >= n) break
        result.add(item)
        i += 1
    }
    return result
}

pub range(start: Int, end: Int, step?: Int = 1): List {
    result: List = List()
    if (step > 0) {
        i: Int = start
        loop {
            if (i >= end) break
            result.add(i)
            i += step
        }
    } else if (step < 0) {
        i: Int = start
        loop {
            if (i <= end) break
            result.add(i)
            i += step
        }
    }
    return result
}

pub map(list: List, fn: Function): List {
    result: List = List()
    i: Int = 0
    loop {
        if (i >= list.size) break
        result.add(fn(list[i]))
        i += 1
    }
    return result
}

pub filter(list: List, pred: Function): List {
    result: List = List()
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (pred(list[i])) {
            result.add(list[i])
        }
        i += 1
    }
    return result
}

pub reduce(list: List, fn: Function, initial: Any): Any {
    result = initial
    i: Int = 0
    loop {
        if (i >= list.size) break
        result = fn(result, list[i])
        i += 1
    }
    return result
}

pub fold_left(list: List, fn: Function, initial: Any): Any {
    return reduce(list, fn, initial)
}

pub fold_right(list: List, fn: Function, initial: Any): Any {
    result = initial
    i: Int = list.size - 1
    loop {
        if (i < 0) break
        result = fn(list[i], result)
        i -= 1
    }
    return result
}

pub for_each(list: List, fn: Function) {
    i: Int = 0
    loop {
        if (i >= list.size) break
        fn(list[i])
        i += 1
    }
}

pub find_first(list: List, pred: Function): Any {
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (pred(list[i])) {
            return Ok(list[i])
        }
        i += 1
    }
    return Err("No element satisfies predicate")
}

pub find_index(list: List, pred: Function): Int {
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (pred(list[i])) {
            return i
        }
        i += 1
    }
    return -1
}

pub all(list: List, pred: Function): Bool {
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (!pred(list[i])) return false
        i += 1
    }
    return true
}

pub any(list: List, pred: Function): Bool {
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (pred(list[i])) return true
        i += 1
    }
    return false
}

pub none(list: List, pred: Function): Bool {
    return !any(list, pred)
}

pub count(list: List, pred: Function): Int {
    cnt: Int = 0
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (pred(list[i])) cnt += 1
        i += 1
    }
    return cnt
}

pub partition(list: List, pred: Function): List {
    true_list: List = List()
    false_list: List = List()
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (pred(list[i])) {
            true_list.add(list[i])
        } else {
            false_list.add(list[i])
        }
        i += 1
    }
    return List(true_list, false_list)
}

pub group_by(list: List, fn: Function): Any {
    result: List = List()
    keys: List = List()
    i: Int = 0
    loop {
        if (i >= list.size) break
        item = list[i]
        key = fn(item)
        found: Bool = false
        j: Int = 0
        loop {
            if (j >= keys.size) break
            if (keys[j] == key) {
                group: List = result[j]
                group.add(item)
                found = true
                break
            }
            j += 1
        }
        if (!found) {
            keys.add(key)
            newGroup: List = List()
            newGroup.add(item)
            result.add(newGroup)
        }
        i += 1
    }
    return result
}

pub contains(list: List, value: Any): Bool {
    return find(list, value) >= 0
}

pub find(list: List, value: Any): Int {
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (list[i] == value) {
            return i
        }
        i += 1
    }
    return -1
}

pub find_last(list: List, value: Any): Int {
    i: Int = list.size - 1
    loop {
        if (i < 0) break
        if (list[i] == value) {
            return i
        }
        i -= 1
    }
    return -1
}

pub first(list: List): Any {
    if (list.size == 0) {
        return Err("List is empty")
    }
    return Ok(list[0])
}

pub last(list: List): Any {
    if (list.size == 0) {
        return Err("List is empty")
    }
    return Ok(list[list.size - 1])
}

pub nth(list: List, n: Int): Any {
    if (n < 0 || n >= list.size) {
        return Err("Index out of bounds")
    }
    return Ok(list[n])
}

pub sort(list: List): List {
    if (list.size <= 1) return list
    result: List = copy(list)
    i: Int = 0
    loop {
        if (i >= result.size - 1) break
        min_idx: Int = i
        j: Int = i + 1
        loop {
            if (j >= result.size) break
            if (result[j] < result[min_idx]) {
                min_idx = j
            }
            j += 1
        }
        if (min_idx != i) {
            temp = result[i]
            result[i] = result[min_idx]
            result[min_idx] = temp
        }
        i += 1
    }
    return result
}

pub sort_by(list: List, fn: Function): List {
    if (list.size <= 1) return list
    result: List = copy(list)
    keys: List = map(list, fn)
    i: Int = 0
    loop {
        if (i >= result.size - 1) break
        minIdx: Int = i
        j: Int = i + 1
        loop {
            if (j >= result.size) break
            if (keys[j] < keys[minIdx]) {
                minIdx = j
            }
            j += 1
        }
        if (minIdx != i) {
            temp = result[i]
            result[i] = result[minIdx]
            result[minIdx] = temp
            tempKey = keys[i]
            keys[i] = keys[minIdx]
            keys[minIdx] = tempKey
        }
        i += 1
    }
    return result
}

pub reverse_sorted(list: List): List {
    return reverse(sort(list))
}

pub zip_with(list1: List, list2: List, fn: Function): List {
    result: List = List()
    len: Int = list1.size
    if (list2.size < len) { len = list2.size }
    i: Int = 0
    loop {
        if (i >= len) break
        result.add(fn(list1[i], list2[i]))
        i += 1
    }
    return result
}

pub unzip(list: List): List {
    list1: List = List()
    list2: List = List()
    i: Int = 0
    loop {
        if (i >= list.size) break
        pair: List = list[i]
        list1.add(pair[0])
        list2.add(pair[1])
        i += 1
    }
    return List(list1, list2)
}

pub concat(list1: List, list2: List): List {
    result: List = List()
    i: Int = 0
    loop {
        if (i >= list1.size) break
        result.add(list1[i])
        i += 1
    }
    i = 0
    loop {
        if (i >= list2.size) break
        result.add(list2[i])
        i += 1
    }
    return result
}

pub join(list: List, sep?: Str = ","): Str {
    result: Str = ""
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (i > 0) {
            result = result + sep
        }
        result = result + Str(list[i])
        i += 1
    }
    return result
}
pub join_to_string(list: List, sep?: Str = ", ", prefix?: Str = "", suffix?: Str = ""): Str {
    result: Str = prefix
    result = result + join(list, sep)
    result = result + suffix
    return result
}

pub is_list(value: Any): Bool {
    return value -> {
        List = true
        _ = false
    }
}

pub copy(list: List): List {
    result: List = List()
    i: Int = 0
    loop {
        if (i >= list.size) break
        result.add(list[i])
        i += 1
    }
    return result
}

pub fill(item: Any, n: Int): List {
    return repeat(item, n)
}

pub empty(list: List): Bool {
    return list.size == 0
}

pub not_empty(list: List): Bool {
    return list.size > 0
}

pub size(list: List): Int {
    return list.size
}

pub clear(list: List) {
    loop {
        if (list.size == 0) break
        list.erase(list.size - 1)
    }
}

pub head(list: List): Any {
    return first(list)
}

pub tail(list: List): List {
    return drop(list, 1)
}

pub init_list(list: List): List {
    if (list.size <= 1) return List()
    return slice(list, 0, list.size - 1)
}
