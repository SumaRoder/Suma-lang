pub pad_left(s: Str, width: Int, pad?: Str = " "): Str {
    if (s.size >= width) return s
    pad_count: Int = width - s.size
    pad_len: Int = pad.size
    if (pad_len == 0) return s

    result: Str = ""
    i: Int = 0
    loop {
        if (i >= pad_count) break
        result = result + pad[i % pad_len]
        i += 1
    }
    return result + s
}

pub pad_right(s: Str, width: Int, pad?: Str = " "): Str {
    if (s.size >= width) return s
    pad_count: Int = width - s.size
    pad_len: Int = pad.size
    if (pad_len == 0) return s

    result: Str = s
    i: Int = 0
    loop {
        if (i >= pad_count) break
        result = result + pad[i % pad_len]
        i += 1
    }
    return result
}

pub pad_center(s: Str, width: Int, pad?: Str = " "): Str {
    if (s.size >= width) return s
    total_pad: Int = width - s.size
    left_pad: Int = total_pad / 2
    right_pad: Int = total_pad - left_pad

    pad_len: Int = pad.size
    if (pad_len == 0) return s

    result: Str = ""
    i: Int = 0
    loop {
        if (i >= left_pad) break
        result = result + pad[i % pad_len]
        i += 1
    }
    result = result + s
    i = 0
    loop {
        if (i >= right_pad) break
        result = result + pad[i % pad_len]
        i += 1
    }
    return result
}

pub pad(s: Str, width: Int, align?: Str = "left", padChar?: Str = " ") {
    if (align == "left") return pad_right(s, width, padChar)
    if (align == "right") return pad_left(s, width, padChar)
    if (align == "center") return pad_center(s, width, padChar)
    return s
}

pub int_to_str(n: Int, width?: Int = 0, padZero?: Bool = true): Str {
    neg: Bool = n < 0
    s: Str = Str(abs(n))
    if (width > 0 && s.size < width) {
        pad_char: Str = "0"
        if (!padZero) { pad_char = " " }
        if (neg) {
            return "-" + pad_left(s, width - 1, pad_char)
        }
        return pad_left(s, width, pad_char)
    }
    if (neg) return "-" + s
    return s
}

pub int_to_str_signed(n: Int, width?: Int = 0): Str {
    sign: Str = "-"
    if (n >= 0) { sign = "+" }
    new_width: Int = 0
    if (width > 0) { new_width = width - 1 }
    return sign + int_to_str(abs(n), new_width)
}

pub int_with_commas(n: Int): Str {
    if (n == 0) return "0"
    neg: Bool = n < 0
    s: Str = Str(abs(n))
    result: Str = ""
    i: Int = s.size - 1
    count: Int = 0
    loop {
        if (i < 0) break
        result = s[i] + result
        count += 1
        if (count % 3 == 0 && i > 0) {
            result = "," + result
        }
        i -= 1
    }
    if (neg) return "-" + result
    return result
}

pub format_percent(n: Int, decimals?: Int = 0): Str {
    if (decimals == 0) return Str(n) + "%"

    factor: Int = pow10(decimals)
    int_part: Int = n
    frac_part: Int = 0

    result: Str = Str(int_part) + "."
    frac_str: Str = Str(frac_part)
    i: Int = frac_str.size
    loop {
        if (i >= decimals) break
        result = result + "0"
        i += 1
    }
    result = result + frac_str
    return result + "%"
}

pub hex(n: Int, prefix?: Bool = false, upper?: Bool = false): Str {
    if (n == 0) {
        if (prefix) { return "0x0" }
        return "0"
    }

    digits: Str = "0123456789abcdef"
    if (upper) { digits = "0123456789ABCDEF" }
    result: Str = ""
    x: Int = abs(n)

    loop {
        if (x == 0) break
        digit: Int = x % 16
        result = digits[digit] + result
        x = x / 16
    }

    if (n < 0) result = "-" + result
    if (prefix) result = "0x" + result
    return result
}

pub binary(n: Int, prefix?: Bool = false): Str {
    if (n == 0) {
        if (prefix) { return "0b0" }
        return "0"
    }

    result: Str = ""
    x: Int = abs(n)

    loop {
        if (x == 0) break
        bit: Int = x % 2
        result = Str(bit) + result
        x = x / 2
    }

    if (n < 0) result = "-" + result
    if (prefix) result = "0b" + result
    return result
}

pub octal(n: Int, prefix?: Bool = false): Str {
    if (n == 0) {
        if (prefix) { return "0o0" }
        return "0"
    }

    result: Str = ""
    x: Int = abs(n)

    loop {
        if (x == 0) break
        digit: Int = x % 8
        result = Str(digit) + result
        x = x / 8
    }

    if (n < 0) result = "-" + result
    if (prefix) result = "0o" + result
    return result
}

pub base(n: Int, b: Int): Str {
    if (b < 2 || b > 36) return Str(n)
    if (n == 0) return "0"

    digits: Str = "0123456789abcdefghijklmnopqrstuvwxyz"
    result: Str = ""
    x: Int = abs(n)

    loop {
        if (x == 0) break
        digit: Int = x % b
        result = digits[digit] + result
        x = x / b
    }

    if (n < 0) result = "-" + result
    return result
}

pub parse_int(s: Str, base?: Int = 10): Any {
    if (base < 2 || base > 36) return Err("Invalid base: " + Str(base))

    s = trim(s)
    if (s.size == 0) return Err("Empty string")

    neg: Bool = false
    if (s[0] == "-") {
        neg = true
        s = slice_str(s, 1, s.size)
    } else if (s[0] == "+") {
        s = slice_str(s, 1, s.size)
    }

    result: Int = 0
    i: Int = 0
    loop {
        if (i >= s.size) break
        ch: Str = lower(s[i])
        digit: Int = -1

        if (ch >= "0" && ch <= "9") {
            digit = char_to_int(ch)
        } else if (ch >= "a" && ch <= "z") {
            digit = 10 + char_to_int(ch) - char_to_int("a")
        }

        if (digit < 0 || digit >= base) {
            return Err("Invalid digit '" + s[i] + "' for base " + Str(base))
        }

        result = result * base + digit
        i += 1
    }

    if (neg) result = -result
    return Ok(result)
}

pub format(template: Str, args: List): Str {
    result: Str = ""
    argIdx: Int = 0
    i: Int = 0

    loop {
        if (i >= template.size) break
        ch: Str = template[i]

        if (ch == "{" && i + 1 < template.size) {
            if (template[i + 1] == "}") {
                if (argIdx < args.size) {
                    result = result + Str(args[argIdx])
                    argIdx += 1
                }
                i += 2
            } else if (template[i + 1] >= "0" && template[i + 1] <= "9") {
                idx: Int = char_to_int(template[i + 1])
                if (i + 2 < template.size && template[i + 2] == "}") {
                    if (idx < args.size) {
                        result = result + Str(args[idx])
                    }
                    i += 3
                } else {
                    result = result + ch
                    i += 1
                }
            } else {
                result = result + ch
                i += 1
            }
        } else if (ch == "\\" && i + 1 < template.size) {
            nextCh: Str = template[i + 1]
            if (nextCh == "{" || nextCh == "}") {
                result = result + nextCh
                i += 2
            } else if (nextCh == "n") {
                result = result + "\n"
                i += 2
            } else if (nextCh == "t") {
                result = result + "\t"
                i += 2
            } else {
                result = result + ch
                i += 1
            }
        } else {
            result = result + ch
            i += 1
        }
    }

    return result
}

pub sprintf(fmt: Str, args: List): Str {
    return format(fmt, args)
}

pub truncate(s: Str, maxLen: Int, suffix?: Str = "...", wordBoundary?: Bool = false): Str {
    if (s.size <= maxLen) return s

    if (wordBoundary) {
        end_pos: Int = maxLen - suffix.size
        while (end_pos > 0 && s[end_pos] != " " && s[end_pos] != "\t" && s[end_pos] != "\n") {
            end_pos -= 1
        }
        if (end_pos > 0) {
            return slice_str(s, 0, end_pos) + suffix
        }
    }

    return slice_str(s, 0, maxLen - suffix.size) + suffix
}

pub lines(s: Str): List {
    result: List = List()
    if (s.size == 0) {
        result.add("")
        return result
    }

    current: Str = ""
    i: Int = 0
    loop {
        if (i >= s.size) break
        ch: Str = s[i]
        if (ch == "\n") {
            result.add(current)
            current = ""
        } else if (ch != "\r") {
            current = current + ch
        }
        i += 1
    }
    result.add(current)
    return result
}

pub words(s: Str): List {
    result: List = List()
    current: Str = ""
    i: Int = 0
    in_word: Bool = false

    loop {
        if (i >= s.size) break
        ch: Str = s[i]
        if (ch == " " || ch == "\t" || ch == "\n" || ch == "\r") {
            if (in_word) {
                result.add(current)
                current = ""
                in_word = false
            }
        } else {
            current = current + ch
            in_word = true
        }
        i += 1
    }

    if (in_word) {
        result.add(current)
    }
    return result
}

pub repeat_str(s: Str, n: Int): Str {
    result: Str = ""
    i: Int = 0
    loop {
        if (i >= n) break
        result = result + s
        i += 1
    }
    return result
}

pub justify(s: Str, width: Int, align?: Str = "left"): Str {
    if (s.size >= width) return s

    if (align == "left") {
        return pad_right(s, width, " ")
    } else if (align == "right") {
        return pad_left(s, width, " ")
    } else if (align == "center") {
        return pad_center(s, width, " ")
    } else if (align == "justify") {
        ws: List = words(s)
        if (ws.size <= 1) return pad_right(s, width, " ")

        total_spaces: Int = width - s.size + (ws.size - 1)
        space_per_gap: Int = total_spaces / (ws.size - 1)
        extra_spaces: Int = total_spaces % (ws.size - 1)

        result: Str = ""
        i: Int = 0
        loop {
            if (i >= ws.size) break
            result = result + ws[i]
            if (i < ws.size - 1) {
                spaces: Int = space_per_gap
                if (i < extra_spaces) { spaces = spaces + 1 }
                j: Int = 0
                loop {
                    if (j >= spaces) break
                    result = result + " "
                    j += 1
                }
            }
            i += 1
        }
        return result
    }
    return s
}

