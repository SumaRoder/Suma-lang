pub justify(s: Str, width: Int, align?: Str = "left"): Str {
    if (s.size >= width) return s

    if (align == "left") {
        return pad_right(s, width, " ")
    } else if (align == "right") {
        return pad_left(s, width, " ")
    } else if (align == "center") {
        return pad_center(s, width, " ")
    } else if (align == "justify") {
        ws: List = words(s)
        if (ws.size <= 1) return pad_right(s, width, " ")

        totalSpaces: Int = width - s.size + (ws.size - 1)
        spacePerGap: Int = totalSpaces / (ws.size - 1)
        extraSpaces: Int = totalSpaces % (ws.size - 1)

        result: Str = ""
        i: Int = 0
        loop {
            if (i >= ws.size) break
            result = result + ws[i]
            if (i < ws.size - 1) {
                spaces: Int = spacePerGap
                if (i < extraSpaces) { spaces = spaces + 1 }
                j: Int = 0
                loop {
                    if (j >= spaces) break
                    result = result + " "
                    j += 1
                }
            }
            i += 1
        }
        return result
    }
    return s
}

pri abs(n: Int): Int {
    if (n < 0) return -n
    return n
}

pri pow10(n: Int): Int {
    result: Int = 1
    i: Int = 0
    loop {
        if (i >= n) break
        result = result * 10
        i += 1
    }
    return result
}

pri trim(s: Str): Str {
    start: Int = 0
    end: Int = s.size

    loop {
        if (start >= end) break
        ch: Str = s[start]
        if (ch != " " && ch != "\t" && ch != "\n" && ch != "\r") break
        start += 1
    }

    loop {
        if (end <= start) break
        ch: Str = s[end - 1]
        if (ch != " " && ch != "\t" && ch != "\n" && ch != "\r") break
        end -= 1
    }

    return slice_str(s, start, end)
}

pri slice_str(s: Str, start: Int, end: Int): Str {
    result: Str = ""
    i: Int = start
    loop {
        if (i >= end || i >= s.size) break
        result = result + s[i]
        i += 1
    }
    return result
}

pri lower(s: Str): Str {
    result: Str = ""
    i: Int = 0
    loop {
        if (i >= s.size) break
        ch: Str = s[i]
        if (ch >= "A" && ch <= "Z") {
            result = result + Str(char_from_int(char_to_int(ch) + 32))
        } else {
            result = result + ch
        }
        i += 1
    }
    return result
}

pri char_to_int(ch: Str): Int {
    if (ch.size == 0) return 0
    return ch[0] as Int
}

pri char_from_int(n: Int): Str {
    return Str(n)
}
