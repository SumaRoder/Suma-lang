pub Stack {
    pri data: List

    pub setup() {
        this.data = List()
    }

    pub push(item: Any) {
        this.data.add(item)
    }

    pub pop(): Any {
        if (this.empty()) {
            return Err("Stack is empty")
        }
        idx: Int = this.data.size - 1
        item: Any = this.data[idx]
        this.data.erase(idx)
        return Ok(item)
    }

    pub peek(): Any {
        if (this.empty()) {
            return Err("Stack is empty")
        }
        return Ok(this.data[this.data.size - 1])
    }

    pub empty(): Bool {
        return this.data.size == 0
    }

    pub size(): Int {
        return this.data.size
    }

    pub clear() {
        this.data = List()
    }

    pub to_list(): List {
        return copy_list(this.data)
    }

    pub to_str(): Str {
        return "Stack(" + this.data.to_str() + ")"
    }
}

pub Queue {
    pri data: List

    pub setup() {
        this.data = List()
    }

    pub enqueue(item: Any) {
        this.data.add(item)
    }

    pub dequeue(): Any {
        if (this.empty()) {
            return Err("Queue is empty")
        }
        item: Any = this.data[0]
        this.data.erase(0)
        return Ok(item)
    }

    pub peek(): Any {
        if (this.empty()) {
            return Err("Queue is empty")
        }
        return Ok(this.data[0])
    }

    pub empty(): Bool {
        return this.data.size == 0
    }

    pub size(): Int {
        return this.data.size
    }

    pub clear() {
        this.data = List()
    }

    pub to_list(): List {
        return copy_list(this.data)
    }

    pub to_str(): Str {
        return "Queue(" + this.data.to_str() + ")"
    }
}

pub Deque {
    pri data: List

    pub setup() {
        this.data = List()
    }

    pub push_front(item: Any) {
        this.data.add(item)
        i: Int = this.data.size - 1
        loop {
            if (i <= 0) break
            temp: Any = this.data[i]
            this.data[i] = this.data[i - 1]
            this.data[i - 1] = temp
            i -= 1
        }
    }

    pub push_back(item: Any) {
        this.data.add(item)
    }

    pub pop_front(): Any {
        if (this.empty()) {
            return Err("Deque is empty")
        }
        item: Any = this.data[0]
        this.data.erase(0)
        return Ok(item)
    }

    pub pop_back(): Any {
        if (this.empty()) {
            return Err("Deque is empty")
        }
        idx: Int = this.data.size - 1
        item: Any = this.data[idx]
        this.data.erase(idx)
        return Ok(item)
    }

    pub peek_front(): Any {
        if (this.empty()) {
            return Err("Deque is empty")
        }
        return Ok(this.data[0])
    }

    pub peek_back(): Any {
        if (this.empty()) {
            return Err("Deque is empty")
        }
        return Ok(this.data[this.data.size - 1])
    }

    pub empty(): Bool {
        return this.data.size == 0
    }

    pub size(): Int {
        return this.data.size
    }

    pub clear() {
        this.data = List()
    }

    pub to_list(): List {
        return copy_list(this.data)
    }
}

pub HashMap {
    pri keys: List
    pri values: List

    pub setup() {
        this.keys = List()
        this.values = List()
    }

    pub put(key: Any, value: Any) {
        idx: Int = find_key_index(this.keys, key)
        if (idx >= 0) {
            this.values[idx] = value
        } else {
            this.keys.add(key)
            this.values.add(value)
        }
    }

    pub get(key: Any): Any {
        idx: Int = find_key_index(this.keys, key)
        if (idx >= 0) {
            return Ok(this.values[idx])
        }
        return Err("Key not found: " + Str(key))
    }

    pub get_or(key: Any, default: Any): Any {
        idx: Int = find_key_index(this.keys, key)
        if (idx >= 0) {
            return this.values[idx]
        }
        return default
    }

    pub contains(key: Any): Bool {
        return find_key_index(this.keys, key) >= 0
    }

    pub remove(key: Any): Bool {
        idx: Int = find_key_index(this.keys, key)
        if (idx >= 0) {
            this.keys.erase(idx)
            this.values.erase(idx)
            return true
        }
        return false
    }

    pub size(): Int {
        return this.keys.size
    }

    pub empty(): Bool {
        return this.keys.size == 0
    }

    pub clear() {
        this.keys = List()
        this.values = List()
    }

    pub keys_list(): List {
        return copy_list(this.keys)
    }

    pub values_list(): List {
        return copy_list(this.values)
    }

    pub entries(): List {
        result: List = List()
        i: Int = 0
        loop {
            if (i >= this.keys.size) break
            result.add(List(this.keys[i], this.values[i]))
            i += 1
        }
        return result
    }

    pub map_values(fn: Function): HashMap {
        result: HashMap = HashMap()
        result.setup()
        i: Int = 0
        loop {
            if (i >= this.keys.size) break
            new_value: Any = fn(this.values[i])
            result.put(this.keys[i], new_value)
            i += 1
        }
        return result
    }

    pub filter(fn: Function): HashMap {
        result: HashMap = HashMap()
        result.setup()
        i: Int = 0
        loop {
            if (i >= this.keys.size) break
            if (fn(this.keys[i], this.values[i])) {
                result.put(this.keys[i], this.values[i])
            }
            i += 1
        }
        return result
    }

    pub to_str(): Str {
        entries: List = List()
        i: Int = 0
        loop {
            if (i >= this.keys.size) break
            entries.add(Str(this.keys[i]) + "=" + Str(this.values[i]))
            i += 1
        }
        return "{" + join(entries, ", ") + "}"
    }
}

pub Set {
    pri data: List

    pub setup() {
        this.data = List()
    }

    pub add(item: Any) {
        if (!this.contains(item)) {
            this.data.add(item)
        }
    }

    pub contains(item: Any): Bool {
        return find_key_index(this.data, item) >= 0
    }

    pub remove(item: Any): Bool {
        i: Int = find_key_index(this.data, item)
        if (i >= 0) {
            this.data.erase(i)
            return true
        }
        return false
    }

    pub size(): Int {
        return this.data.size
    }

    pub empty(): Bool {
        return this.data.size == 0
    }

    pub to_list(): List {
        return copy_list(this.data)
    }

    pub clear() {
        this.data = List()
    }

    pub union(other: Set): Set {
        result: Set = Set()
        result.setup()
        i: Int = 0
        loop {
            if (i >= this.data.size) break
            result.add(this.data[i])
            i += 1
        }
        i = 0
        loop {
            if (i >= other.data.size) break
            result.add(other.data[i])
            i += 1
        }
        return result
    }

    pub intersect(other: Set): Set {
        result: Set = Set()
        result.setup()
        i: Int = 0
        loop {
            if (i >= this.data.size) break
            item: Any = this.data[i]
            if (other.contains(item)) {
                result.add(item)
            }
            i += 1
        }
        return result
    }

    pub difference(other: Set): Set {
        result: Set = Set()
        result.setup()
        i: Int = 0
        loop {
            if (i >= this.data.size) break
            item: Any = this.data[i]
            if (!other.contains(item)) {
                result.add(item)
            }
            i += 1
        }
        return result
    }

    pub is_subset(other: Set): Bool {
        i: Int = 0
        loop {
            if (i >= this.data.size) break
            if (!other.contains(this.data[i])) return false
            i += 1
        }
        return true
    }

    pub is_superset(other: Set): Bool {
        return other.is_subset(this)
    }

    pub to_str(): Str {
        return "Set(" + this.data.to_str() + ")"
    }
}

pub PriorityQueue {
    pri items: List
    pri priorities: List

    pub setup() {
        this.items = List()
        this.priorities = List()
    }

    pub enqueue(item: Any, priority: Int) {
        i: Int = 0
        loop {
            if (i >= this.priorities.size) break
            if (priority < this.priorities[i]) break
            i += 1
        }
        this.items.insert(i, item)
        this.priorities.insert(i, priority)
    }

    pub dequeue(): Any {
        if (this.empty()) {
            return Err("PriorityQueue is empty")
        }
        item: Any = this.items[0]
        this.items.erase(0)
        this.priorities.erase(0)
        return Ok(item)
    }

    pub peek(): Any {
        if (this.empty()) {
            return Err("PriorityQueue is empty")
        }
        return Ok(this.items[0])
    }

    pub empty(): Bool {
        return this.items.size == 0
    }

    pub size(): Int {
        return this.items.size
    }

    pub clear() {
        this.items = List()
        this.priorities = List()
    }
}

pri find_key_index(keys: List, key: Any): Int {
    i: Int = 0
    loop {
        if (i >= keys.size) break
        if (keys[i] == key) {
            return i
        }
        i += 1
    }
    return -1
}

pri copy_list(list: List): List {
    result: List = List()
    i: Int = 0
    loop {
        if (i >= list.size) break
        result.add(list[i])
        i += 1
    }
    return result
}

pri join(list: List, sep: Str): Str {
    result: Str = ""
    i: Int = 0
    loop {
        if (i >= list.size) break
        if (i > 0) result = result + sep
        result = result + Str(list[i])
        i += 1
    }
    return result
}
