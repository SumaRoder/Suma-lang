import "core.nk"
import "math.nk"
import "list.nk"
import "collections.nk"
import "format.nk"
import "time.nk"
import "assert.nk"

pub test_math() {
    assert_eq(abs(-5), 5, "abs test")
    print("abs")
    assert_eq(max(3, 7), 7, "max test")
    print("max")
    assert_eq(min(3, 7), 3, "min test")
    print("min")
    assert_eq(pow(2, 3), 8, "pow test")
    print("pow")
    assert_eq(clamp(5, 0, 10), 5, "clamp in range")
    print("cir")
    assert_eq(gcd(12, 8), 4, "gcd test")
    print("gcd")
    assert_eq(lcm(4, 6), 12, "lcm test")
    print("lcm")

    numbers: List = List(1, 2, 3, 4, 5)
    assert_eq(sum(numbers), 15, "sum test")
    print("sum")

    max_result: Any = max_in_list(numbers)
    assert_ok(max_result, "max_in_list should be Ok")
    print("mil")

    min_result: Any = min_in_list(numbers)
    assert_ok(min_result, "min_in_list should be Ok")
    print("mil2")

    print("  Math tests passed")
}

pub test_collections() {
    stack: Stack = Stack()
    stack.setup()
    assert_true(stack.empty(), "new stack should be empty")

    stack.push(1)
    stack.push(2)
    stack.push(3)
    assert_eq(stack.size(), 3, "stack size after push")

    pop_result: Any = stack.pop()
    assert_ok(pop_result, "pop should succeed")
    assert_eq(stack.size(), 2, "stack size after pop")

    queue: Queue = Queue()
    queue.setup()
    queue.enqueue("a")
    queue.enqueue("b")
    assert_eq(queue.size(), 2, "queue size")

    set: Set = Set()
    set.setup()
    set.add(1)
    set.add(2)
    set.add(1)
    assert_eq(set.size(), 2, "set size (no duplicates)")
    assert_true(set.contains(1), "set contains 1")

    map: HashMap = HashMap()
    map.setup()
    map.put("key1", "value1")
    assert_eq(map.size(), 1, "map size")
    assert_true(map.contains("key1"), "map contains key1")

    print("  Collections tests passed")
}

pub test_list_functions() {
    numbers: List = List(1, 2, 3, 4, 5)

    taken: List = take(numbers, 3)
    assert_eq(taken.size, 3, "take 3")
    print("take")

    dropped: List = drop(numbers, 2)
    assert_eq(dropped.size, 3, "drop 2")
    print("drop")

    dups: List = List(1, 2, 2, 3, 3, 3)
    uniq: List = distinct(dups)
    assert_eq(uniq.size, 3, "distinct")
    print("distinct")

    print("  List function tests passed")
}

pub test_core() {
    ok_result: Any = Ok(42)
    assert_true(is_ok(ok_result), "is_ok test")
    print("isOk")
    assert_false(is_err(ok_result), "is_err test")
    print("isErr")

    unwrapped: Any = unwrap_or(ok_result, 0)
    assert_eq(unwrapped, 42, "unwrap_or with Ok")
    print("unwarp_or Ok")

    err_result: Any = Err("error")
    unwrapped_err: Any = unwrap_or(err_result, 999)
    assert_eq(unwrapped_err, 999, "unwrap_or with Err")
    print("unwrap_or Err")

    r: Range = Range()
    r.setup(0, 5, 1)
    assert_eq(r.size(), 5, "range size")
    print("range")
    assert_true(r.contains(3), "range contains 3")
    assert_false(r.contains(5), "range does not contain 5")
    print("range contains")

    p: Pair = Pair()
    print("pair")
    p.setup("hello", 42)
    print("setup")
    assert_eq(p.first(), "hello", "pair first")
    print("pair1")
    assert_eq(p.second(), 42, "pair second")
    print("pair2")

    print("  Core tests passed")
}

pub test_format() {
    padded: Str = pad_left("hi", 5, "0")
    assert_eq(padded, "000hi", "pad_left")

    padded = pad_right("hi", 5, "-")
    assert_eq(padded, "hi---", "pad_right")

    hex_str: Str = hex(255)
    assert_eq(hex_str, "ff", "hex")

    bin_str: Str = binary(5)
    assert_eq(bin_str, "101", "binary")

    print("  Format tests passed")
}

pub test_time() {
    rand: Random = Random()
    rand.setup()
    r1: Int = rand.next()
    r2: Int = rand.next()
    assert_true(r1 != r2, "random numbers should differ")
    print(r1, r2)

    rand_in_range: Int = rand.next_range(1, 10)
    assert_true(rand_in_range >= 1 && rand_in_range <= 10, "random in range")
    print(rand_in_range)

    print("  Time tests passed")
}

pub main(): Int {
    print("=== Testing stdlib ===")
    print("")

    print("Running math tests...")
    test_math()

    print("Running collections tests...")
    test_collections()

    print("Running list function tests...")
    test_list_functions()

    print("Running core tests...")
    test_core()

    print("Running format tests...")
    test_format()

    print("Running time tests...")
    test_time()

    print("")
    print("=== All tests passed! ===")
    return 0
}