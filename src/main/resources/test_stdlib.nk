import "core.nk"
import "math.nk"
import "list.nk"
import "collections.nk"
import "format.nk"
import "time.nk"
import "assert.nk"

pub testMath() {
    assertEq(abs(-5), 5, "abs test")
    print("abs")
    assertEq(max(3, 7), 7, "max test")
    print("max")
    assertEq(min(3, 7), 3, "min test")
    print("min")
    assertEq(pow(2, 3), 8, "pow test")
    print("pow")
    assertEq(clamp(5, 0, 10), 5, "clamp in range")
    print("cir")
    assertEq(gcd(12, 8), 4, "gcd test")
    print("gcd")
    assertEq(lcm(4, 6), 12, "lcm test")
    print("lcm")

    numbers: List = List(1, 2, 3, 4, 5)
    assertEq(sum(numbers), 15, "sum test")
    print("sum")

    maxResult: Any = maxInList(numbers)
    assertOk(maxResult, "maxInList should be Ok")
    print("mil")

    minResult: Any = minInList(numbers)
    assertOk(minResult, "minInList should be Ok")
    print("mil2")

    print("  Math tests passed")
}

pub testCollections() {
    stack: Stack = Stack()
    stack.setup()
    assertTrue(stack.isEmpty(), "new stack should be empty")

    stack.push(1)
    stack.push(2)
    stack.push(3)
    assertEq(stack.size(), 3, "stack size after push")

    popResult: Any = stack.pop()
    assertOk(popResult, "pop should succeed")
    assertEq(stack.size(), 2, "stack size after pop")

    queue: Queue = Queue()
    queue.setup()
    queue.enqueue("a")
    queue.enqueue("b")
    assertEq(queue.size(), 2, "queue size")

    set: Set = Set()
    set.setup()
    set.add(1)
    set.add(2)
    set.add(1)
    assertEq(set.size(), 2, "set size (no duplicates)")
    assertTrue(set.contains(1), "set contains 1")

    map: HashMap = HashMap()
    map.setup()
    map.put("key1", "value1")
    assertEq(map.size(), 1, "map size")
    assertTrue(map.contains("key1"), "map contains key1")

    print("  Collections tests passed")
}

pub testListFunctions() {
    numbers: List = List(1, 2, 3, 4, 5)

    taken: List = take(numbers, 3)
    assertEq(taken.size, 3, "take 3")
    print("take")

    dropped: List = drop(numbers, 2)
    assertEq(dropped.size, 3, "drop 2")
    print("drop")

    dups: List = List(1, 2, 2, 3, 3, 3)
    uniq: List = distinct(dups)
    assertEq(uniq.size, 3, "distinct")
    print("distinct")

    print("  List function tests passed")
}

pub testCore() {
    okResult: Any = Ok(42)
    assertTrue(isOk(okResult), "isOk test")
    print("isOk")
    assertFalse(isErr(okResult), "isErr test")
    print("isErr")

    unwrapped: Any = unwrapOr(okResult, 0)
    assertEq(unwrapped, 42, "unwrapOr with Ok")
    print("unwarpOr Ok")

    errResult: Any = Err("error")
    unwrappedErr: Any = unwrapOr(errResult, 999)
    assertEq(unwrappedErr, 999, "unwrapOr with Err")
    print("unwrapOr Err")

    r: Range = Range()
    r.setup(0, 5, 1)
    assertEq(r.size(), 5, "range size")
    print("range")
    assertTrue(r.contains(3), "range contains 3")
    assertFalse(r.contains(5), "range does not contain 5")
    print("range contains")

    p: Pair = Pair()
    print("pair")
    p.setup("hello", 42)
    print("setup")
    assertEq(p.first(), "hello", "pair first")
    print("pair1")
    assertEq(p.second(), 42, "pair second")
    print("pair2")

    print("  Core tests passed")
}

pub testFormat() {
    padded: Str = padLeft("hi", 5, "0")
    assertEq(padded, "000hi", "padLeft")

    padded = padRight("hi", 5, "-")
    assertEq(padded, "hi---", "padRight")

    hexStr: Str = hex(255)
    assertEq(hexStr, "ff", "hex")

    binStr: Str = binary(5)
    assertEq(binStr, "101", "binary")

    print("  Format tests passed")
}

pub testTime() {
    rand: Random = Random()
    rand.setup(12345)
    r1: Int = rand.next()
    r2: Int = rand.next()
    assertTrue(r1 != r2, "random numbers should differ")

    randInRange: Int = rand.nextRange(1, 10)
    assertTrue(randInRange >= 1 && randInRange <= 10, "random in range")

    print("  Time tests passed")
}

pub main(): Int {
    print("=== Testing stdlib ===")
    print("")

    print("Running math tests...")
    testMath()

    print("Running collections tests...")
    testCollections()

    print("Running list function tests...")
    testListFunctions()

    print("Running core tests...")
    testCore()

    print("Running format tests...")
    testFormat()

    print("Running time tests...")
    testTime()

    print("")
    print("=== All tests passed! ===")
    return 0
}