pub list_sum(items: List): Int {
    total = 0
    i = 0
    loop {
        if (i >= items.size) {
            break
        }
        total += items[i]
        i += 1
    }
    return total
}

pub list_product(items: List): Int {
    result = 1
    i = 0
    loop {
        if (i >= items.size) {
            break
        }
        result *= items[i]
        i += 1
    }
    return result
}

pub list_max(items: List): Int {
    if (items.size == 0) {
        return 0
    }
    best = items[0]
    i = 1
    loop {
        if (i >= items.size) {
            break
        }
        if (items[i] > best) {
            best = items[i]
        }
        i += 1
    }
    return best
}

pub list_min(items: List): Int {
    if (items.size == 0) {
        return 0
    }
    best = items[0]
    i = 1
    loop {
        if (i >= items.size) {
            break
        }
        if (items[i] < best) {
            best = items[i]
        }
        i += 1
    }
    return best
}

pub list_push_range(items: List, start: Int, end: Int): Int {
    i = start
    loop {
        if (i > end) {
            break
        }
        items.add(i)
        i += 1
    }
    return items.size
}
