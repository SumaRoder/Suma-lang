pub abs_int(n: Int): Int {
    if (n < 0) {
        return -n
    }
    return n
}

pub pow_int(base: Int, exp: Int): Int {
    result = 1
    i = 0
    loop {
        if (i >= exp) {
            break
        }
        @result *= base
        @i += 1
    }
    return result
}

pub gcd_int(a: Int, b: Int): Int {
    x = abs_int(a)
    y = abs_int(b)
    loop {
        if (y == 0) {
            break
        }
        r = x % y
        @x = y
        @y = r
    }
    return x
}

pub lcm_int(a: Int, b: Int): Int {
    if (a == 0 || b == 0) {
        return 0
    }
    return abs_int((a / gcd_int(a, b)) * b)
}

pub factorial_int(n: Int): Int {
    result = 1
    i = 2
    loop {
        if (i > n) {
            break
        }
        @result *= i
        @i += 1
    }
    return result
}

pub fib_int(n: Int): Int {
    a = 0
    b = 1
    i = 0
    loop {
        if (i >= n) {
            break
        }
        next = a + b
        @a = b
        @b = next
        @i += 1
    }
    return a
}
