pub is_even(n: Int): Bool {
    return n % 2 == 0
}

pub is_odd(n: Int): Bool {
    return n % 2 != 0
}

pub clamp(n: Int, low: Int, high: Int): Int {
    if (n < low) {
        return low
    }
    if (n > high) {
        return high
    }
    return n
}

pub max_int(a: Int, b: Int): Int {
    if (a > b) {
        return a
    }
    return b
}

pub min_int(a: Int, b: Int): Int {
    if (a < b) {
        return a
    }
    return b
}

pub repeat_str(s: Str, count: Int): Str {
    result = ""
    i = 0
    loop {
        if (i >= count) {
            break
        }
        @result = result + s
        @i += 1
    }
    return result
}

pub require_positive(n: Int) {
    if (n <= 0) {
        return Err("expected positive integer")
    }
    return Ok(n)
}
