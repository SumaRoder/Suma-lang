pub classify(value: Any): Str {
    if value is Int { return "int" }
    if value is Str { return "str" }
    return "other"
}

pub main(): Int {
    result = if classify(42) == "int" { 0 } else { 1 }
    try {
        if result == 0 { throw 42 }
    } catch (err) {
        return err
    }
    return result
}
