pub divide(a: Int, b: Int) {
    if (b == 0) { return Err("division by zero") }
    return Ok(a / b)
}

pub main(): Int {
    ok: R = divide(84, 2)
    err: R = divide(1, 0)
    total: Int = 0

    match ok {
        Ok => total = total + it
        Err => total = total - 1
    }

    if (err?.value == null) {
        @total = total + 0
    }

    return total
}
