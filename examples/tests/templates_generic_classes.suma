Box<T> {
    pub value: T

    init(value: T) {
        this.value = value
    }

    pub get(): T {
        return this.value
    }
}

Pair<A> {
    pub left: A
    pub right: Int

    init(left: A, right: Int) {
        this.left = left
        this.right = right
    }

    pub score(): Int {
        return to_str(this.left).size + this.right
    }
}

pub main(): Int {
    box: Box<Int> = Box(40)
    pair: Pair<Str> = Pair("ok", box.get())
    return pair.score()
}
