Person {
    name: Str
    age: Int = 0

    init(name: Str, age: Int) {
        this.name = name
        this.age = age
    }

    pub greet(): Str {
        return "Hello, I'm {this.name}"
    }
}

pub divide(a: Int, b: Int) {
    if b == 0 {
        return Err("Division by zero")
    }
    return Ok(a / b)
}

pub main(): Int {
    p: Person = Person("Alice", 25)
    print(p.greet())

    result = divide(10, 2)
    match result {
        Ok => print("Result: {it}")
        Err => print("Error: {it}")
    }

    return 0
}
